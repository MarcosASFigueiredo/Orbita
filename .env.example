# Copy to `.env` for local development: cp .env.example .env
#
# Rules (Vite / TanStack Start):
#   - VITE_-prefixed vars are inlined into the CLIENT bundle at build time.
#     Never put secrets here.
#   - Non-prefixed vars are server-only. Read them via process.env inside
#     server functions / middleware only.
#
# On Vercel, set these under Project Settings -> Environment Variables, scoped
# per environment (Production / Preview / your "staging" env). See DEPLOYMENT.md.

# Deploy environment label. Drives the non-production badge (src/env.ts).
# Local: development | Vercel staging env: staging | Vercel production: production
VITE_APP_ENV=development

# --- Postgres (database, via Drizzle) ---
# Server-only secret (NO VITE_ prefix). Drizzle reads this for
# db:generate/migrate/push/seed and the app reads it at runtime.
#
# LOCAL DOCKER DEV (default below): points at the Postgres from docker-compose.
# The app's neon-http driver is auto-redirected to the local proxy on :4444,
# while drizzle-kit connects straight to Postgres on :5432 — one URL, both
# drivers. If you change POSTGRES_PORT, change the :5432 here to match.
DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/main
#
# PRODUCTION / Neon: replace the value above with your Neon connection string
# (Neon dashboard -> Connection Details -> pooled "Connection string").
# WARNING: never run db:migrate / db:seed while DATABASE_URL points at Neon
# unless you intend to change production data.

# Host port for the local Postgres container. Change it if 5432 is already taken
# (e.g. another local Postgres) — and update the :5432 in DATABASE_URL to match.
POSTGRES_PORT=5432

# --- Auth.js (magic-link auth, self-hosted) ---
# Server-only secrets (NO VITE_ prefix).
# AUTH_SECRET signs the session. For local dev any non-empty string works; for
# production generate one with: npx auth secret  (or: openssl rand -base64 33)
AUTH_SECRET=dev-secret-change-me
# Resend free tier — the only non-OSS dependency, used purely as mail transport
# behind src/lib/mail.ts. Key from https://resend.com -> API Keys.
# LEAVE EMPTY IN DEV: with no key, magic-link URLs are printed to the server
# console so you can sign in offline. Set it only for staging/production.
RESEND_API_KEY=
# The console-link fallback above keys off NODE_ENV, which a BUILT server
# (node .output/server/index.mjs) hardcodes to "production" — so set this to 1 to
# force the fallback when running the prod build locally (e.g. to Lighthouse /gm
# against the real bundle). No effect once RESEND_API_KEY is set.
MAIL_DEV_LOG=1
# Verified sender. For quick testing Resend allows "onboarding@resend.dev"
# (delivers only to your own Resend account email); use your own verified
# domain for real players.
EMAIL_FROM="Lagash <onboarding@resend.dev>"
# Optional: only needed if host auto-detection is wrong (trustHost is on).
# AUTH_URL=https://your-app.vercel.app

# --- Add your own below ---
# Client-exposed example:
# VITE_API_URL=http://localhost:3000
# Server-only secret example (NO VITE_ prefix):
# DATABASE_URL=
