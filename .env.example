# Copy to `.env` for local development: cp .env.example .env
#
# Rules (Vite / TanStack Start):
#   - VITE_-prefixed vars are inlined into the CLIENT bundle at build time.
#     Never put secrets here.
#   - Non-prefixed vars are server-only. Read them via process.env inside
#     server functions / middleware only.
#
# On Vercel, set these under Project Settings -> Environment Variables, scoped
# per environment (Production / Preview / your "staging" env). See DEPLOYMENT.md.

# Deploy environment label. Drives the non-production badge (src/env.ts).
# Local: development | Vercel staging env: staging | Vercel production: production
VITE_APP_ENV=development

# --- Neon Postgres (database, via Drizzle) ---
# Server-only secret (NO VITE_ prefix). From the Neon dashboard -> your project
# -> Connection Details -> "Connection string" (use the pooled connection).
# Drizzle reads this for db:generate/migrate/push/seed and at runtime.
DATABASE_URL=

# --- Auth.js (magic-link auth, self-hosted) ---
# Server-only secrets (NO VITE_ prefix).
# AUTH_SECRET signs the session; generate one with: npx auth secret  (or: openssl rand -base64 33)
AUTH_SECRET=
# Resend free tier — the only non-OSS dependency, used purely as mail transport
# behind src/lib/mail.ts. Key from https://resend.com -> API Keys.
RESEND_API_KEY=
# Verified sender. For quick testing Resend allows "onboarding@resend.dev"
# (delivers only to your own Resend account email); use your own verified
# domain for real players.
EMAIL_FROM="Lagash <onboarding@resend.dev>"
# Optional: only needed if host auto-detection is wrong (trustHost is on).
# AUTH_URL=https://your-app.vercel.app

# --- Add your own below ---
# Client-exposed example:
# VITE_API_URL=http://localhost:3000
# Server-only secret example (NO VITE_ prefix):
# DATABASE_URL=
